<resources>
    <!-- The manifest's default theme follows the system before Activity code runs. -->
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/app_accent</item>
        <item name="android:statusBarColor">#090B10</item>
        <item name="android:navigationBarColor">#090B10</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>
